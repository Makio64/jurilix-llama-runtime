-    if (ctx->is_disabled()) {
+    if (ctx->is_disabled() || ctx->token_count.empty()) {
+        return;
+    }
+
+    bool direct_index = cur_p->size == (size_t) ctx->n_vocab;
+    if (direct_index) {
+        for (const auto & kv : ctx->token_count) {
+            const llama_token tok = kv.first;
+            if (tok < 0 || (size_t) tok >= cur_p->size || cur_p->data[tok].id != tok) {
+                direct_index = false;
+                break;
+            }
+        }
+    }
+
+    if (direct_index) {
+        for (const auto & kv : ctx->token_count) {
+            const llama_token tok   = kv.first;
+            const int         count = kv.second;
+
+            assert(count > 0 && count <= ctx->penalty_last_n);
+
+            if (cur_p->data[tok].logit <= 0) {
+                cur_p->data[tok].logit *= ctx->penalty_repeat;
+            } else {
+                cur_p->data[tok].logit /= ctx->penalty_repeat;
+            }
+
+            cur_p->data[tok].logit -= float(count) * ctx->penalty_freq + float(count > 0) * ctx->penalty_present;
+        }
+
+        cur_p->sorted = false;
         return;
     }
 
