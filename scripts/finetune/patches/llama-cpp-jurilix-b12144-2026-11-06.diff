+// UNARY (silu/gelu/relu/sigmoid/softplus) + MUL
+static bool ggml_metal_fusion_check_unary_mul(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(fusion);
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+
+    const ggml_tensor * unary = nodes[0];
+    const ggml_tensor * mul   = nodes[1];
+
+    const ggml_unary_op uop = ggml_get_unary_op(unary);
+    if (uop != GGML_UNARY_OP_SILU &&
+        uop != GGML_UNARY_OP_GELU &&
+        uop != GGML_UNARY_OP_RELU &&
+        uop != GGML_UNARY_OP_SIGMOID &&
+        uop != GGML_UNARY_OP_SOFTPLUS) {
+        return false;
+    }
+
+    if (mul->src[0] != unary && mul->src[1] != unary) {
+        return false;
+    }
+
+    const ggml_tensor * u_src = unary->src[0];
+    const ggml_tensor * other = (mul->src[0] == unary) ? mul->src[1] : mul->src[0];
+
+    if (u_src->type != GGML_TYPE_F32 || other->type != GGML_TYPE_F32 ||
+        unary->type != GGML_TYPE_F32 || mul->type   != GGML_TYPE_F32) {
+        return false;
+    }
+
+    if (!ggml_are_same_shape(u_src, other) || !ggml_are_same_shape(u_src, mul)) {
+        return false;
+    }
+
+    if (!ggml_is_contiguous_1(u_src) || !ggml_is_contiguous_1(other) || !ggml_is_contiguous(mul)) {
+        return false;
+    }
+
+    if (mode == GGML_METAL_FUSION_STRUCTURAL) {
+        return true;
+    }
+
+    return (mul->data == u_src->data || !ggml_metal_fusion_overlap(mul, u_src)) &&
+           (mul->data == other->data || !ggml_metal_fusion_overlap(mul, other));
