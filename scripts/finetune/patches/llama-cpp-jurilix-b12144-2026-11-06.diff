+// SCALE + UNARY (tanh) + SCALE (logit softcapping)
+static bool ggml_metal_fusion_check_scale_tanh_scale(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(fusion);
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+    GGML_UNUSED(mode);
+
+    const ggml_tensor * s0   = nodes[0];
+    const ggml_tensor * tanh = nodes[1];
+    const ggml_tensor * s1   = nodes[2];
+
+    if (s0->op != GGML_OP_SCALE || s0->src[1] != nullptr ||
+        tanh->op != GGML_OP_UNARY || ggml_get_unary_op(tanh) != GGML_UNARY_OP_TANH ||
+        s1->op != GGML_OP_SCALE || s1->src[1] != nullptr) {
+        return false;
+    }
+
+    if (s0->src[0]->type != s1->type ||
+        (s0->type != GGML_TYPE_F32 && s0->type != GGML_TYPE_F16) ||
+        tanh->type != s0->type || s1->type != s0->type) {
+        return false;
+    }
+
+    return ggml_is_contiguous_rows(s0->src[0]);
+}
+
+// ROPE + VIEW + SET_ROWS (write rotated K directly to KV cache)
+static bool ggml_metal_fusion_check_rope_set_rows(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(fusion);
+
+    const ggml_tensor * rope     = nodes[0];
+    const ggml_tensor * set_rows = nodes[1];
+
+    if (rope->op != GGML_OP_ROPE || set_rows->op != GGML_OP_SET_ROWS) {
+        return false;
+    }
+
+    if ((rope->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    const int rope_mode = ((const int32_t *) rope->op_params)[2];
+    const bool is_mrope  = (rope_mode & GGML_ROPE_TYPE_MROPE) != 0;
+    const bool is_imrope = rope_mode == GGML_ROPE_TYPE_IMROPE;
+    const bool is_vision = rope_mode == GGML_ROPE_TYPE_VISION;
+    if (is_mrope || is_imrope || is_vision) {
+        return false;
+    }
+
+    if ((rope->src[0]->type != GGML_TYPE_F32 && rope->src[0]->type != GGML_TYPE_F16) ||
+        rope->type != rope->src[0]->type) {
+        return false;
+    }
+
+    if (set_rows->type != GGML_TYPE_F32 && set_rows->type != GGML_TYPE_F16) {
+        return false;
+    }
+
+    const ggml_tensor * rope_view = set_rows->src[0];
+    const ggml_tensor * row_idxs  = set_rows->src[1];
+
+    if (!row_idxs || row_idxs->type != GGML_TYPE_I64) {
+        return false;
+    }
+
+    if (rope_view != rope) {
+        if (rope_view->op != GGML_OP_VIEW || rope_view->src[0] != rope || rope_view->view_offs != 0) {
+            return false;
+        }
+    }
+
+    if (rope->ne[3] != 1 || set_rows->ne[2] != 1 || set_rows->ne[3] != 1 ||
+        row_idxs->ne[1] != 1 || row_idxs->ne[2] != 1 || row_idxs->ne[3] != 1) {
+        return false;
+    }
+
+    if (!ggml_is_contiguous(rope) || !ggml_is_contiguous_rows(set_rows) || !ggml_is_contiguous(row_idxs)) {
+        return false;
+    }
+
+    if (set_rows->ne[0] != rope->ne[0] * rope->ne[1] || row_idxs->ne[0] != rope->ne[2]) {
+        return false;
+    }
+
+    const int rope_raw_idx     = node_idxs[idx];
+    const int set_rows_raw_idx = node_idxs[idx + 1];
+    if (ggml_node_get_use_count(gf, rope_raw_idx) != 1) {
+        return false;
+    }
+    if (rope_view != rope) {
+        if (set_rows_raw_idx < rope_raw_idx + 2 || gf->nodes[rope_raw_idx + 1] != rope_view ||
+            (rope_view->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+            ggml_node_get_use_count(gf, rope_raw_idx + 1) != 1) {
+            return false;
+        }
+    }
+
+    if (mode == GGML_METAL_FUSION_FULL) {
+        if (!rope->src[0]->data || !rope->src[1]->data || !row_idxs->data || !set_rows->data) {
+            return false;
+        }
+        if (ggml_metal_fusion_overlap(set_rows, rope->src[0]) ||
+            ggml_metal_fusion_overlap(set_rows, rope->src[1]) ||
+            (rope->src[2] && ggml_metal_fusion_overlap(set_rows, rope->src[2])) ||
+            ggml_metal_fusion_overlap(set_rows, row_idxs)) {
+            return false;
+        }
+    }
+
+    return true;
+}
