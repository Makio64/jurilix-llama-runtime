+        case GGML_UNARY_OP_SILU:     op_str = "swiglu";       can_c4 = true; break;
+        case GGML_UNARY_OP_SIGMOID:  op_str = "sigmoid_mul";  can_c4 = true; break;
+        case GGML_UNARY_OP_SOFTPLUS: op_str = "softplus_mul"; can_c4 = true; break;
