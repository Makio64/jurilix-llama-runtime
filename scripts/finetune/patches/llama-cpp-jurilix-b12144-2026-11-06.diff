+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_unary_mul(ggml_metal_library_t lib, const ggml_tensor * op, const ggml_tensor * mul) {
+    const ggml_tensor * u_src = op->src[0];
+    const ggml_tensor * other = (mul->src[0] == op) ? mul->src[1] : mul->src[0];
+
+    GGML_ASSERT(ggml_is_contiguous_1(u_src));
