+// RMS_NORM + VIEW + SET_ROWS (write normalized V directly to KV cache)
+static bool ggml_metal_fusion_check_norm_set_rows(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(fusion);
+
+    const ggml_tensor * norm     = nodes[0];
+    const ggml_tensor * set_rows = nodes[1];
+
+    if (norm->op != GGML_OP_RMS_NORM || set_rows->op != GGML_OP_SET_ROWS) {
+        return false;
+    }
+
+    if ((norm->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    if (norm->src[0]->type != GGML_TYPE_F32 || norm->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous_rows(norm->src[0])) {
+        return false;
+    }
+
+    if (set_rows->type != GGML_TYPE_F32 && set_rows->type != GGML_TYPE_F16) {
+        return false;
